# برای ارسال ایمیل سفارش‌ها و پیام‌های تماس (سرویس Resend - resend.com)
RESEND_API_KEY=
# ایمیلی که سفارش‌ها و پیام‌های تماس به آن ارسال می‌شود
ORDER_RECIPIENT_EMAIL=orders@gorg-restaurant.ir
# شماره واتساپ رستوران با کد کشور و بدون صفر ابتدایی، مثل 989121234567
NEXT_PUBLIC_WHATSAPP_NUMBER=989120000000

# درگاه پرداخت زرین‌پال - تا وقتی خالی باشد، سفارش بدون پرداخت آنلاین ثبت می‌شود
ZARINPAL_MERCHANT_ID=
# برای تست قبل از تأیید نهایی درگاه: true بگذارید (بعداً حذف کنید یا false کنید)
ZARINPAL_SANDBOX=false

# پیامک سفارش با کاوه‌نگار - تا وقتی خالی باشد، پیامکی ارسال نمی‌شود
KAVENEGAR_API_KEY=
# اختیاری؛ اگر خط اختصاصی دارید شماره‌اش را بگذارید
KAVENEGAR_SENDER=

# دیتابیس (برای ذخیره و پیگیری سفارش‌ها) - از داشبورد Vercel یک دیتابیس
# Postgres/Neon وصل کنید تا این متغیر خودکار تنظیم شود
DATABASE_URL=

# رمز عبور پنل مدیریت (صفحه‌ی /admin) - یک رمز قوی انتخاب کنید
ADMIN_PASSWORD=

